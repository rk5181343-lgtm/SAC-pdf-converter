# Copy to .env for local development. Never commit .env.

# Postgres when set (postgres://user:pass@host:5432/db); SQLite otherwise.
# DATABASE_URL=

# Where the SQLite file and uploaded files live. On serverless hosts both must
# move to the database: set STORAGE_MODE=db and point DATABASE_URL at Postgres.
# SQLITE_PATH=./data/workspace.db
# STORAGE_DIR=./data/files
# STORAGE_MODE=fs

# Job execution: threads on a long-lived host, poll-driven on serverless.
# Leave unset locally; the app turns threads off automatically under Vercel.
# BACKGROUND_THREADS=true

# Limits
# MAX_UPLOAD_MB=40
# MAX_PAGES=150
# MAX_FILES_PER_RUN=25

# Optional: OCR resolution for scanned pages
# OCR_DPI=200

# Optional: Exa web search for the "look something up" panel
# EXA_API_KEY=

# Optional: required by POST /api/library/clear when set
# ADMIN_TOKEN=

# Server
# PORT=5000
# FLASK_DEBUG=true
